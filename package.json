{
  "name": "grace-community-church",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "cd server && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "seed": "cd server && npm run seed",
